[Unit]
Description=Online Study Room (Spring Boot)
After=network.target

[Service]
Type=simple
User=studyroom
WorkingDirectory=/opt/study-room
ExecStart=/usr/bin/java -jar /opt/study-room/study-room.jar
Restart=on-failure
RestartSec=5
# 密钥建议用 EnvironmentFile（配合部署脚本自动生成），不要硬编码在服务文件里
EnvironmentFile=/opt/study-room/.env

[Install]
WantedBy=multi-user.target
