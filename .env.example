# ============ 网页版自习室 环境变量示例 ============
# 复制为 .env（已被 gitignore，不会提交），按需修改。
# 本地开发可只填 DEEPSEEK_API_KEY；服务器部署时请填生产密钥。

# 启动 profile：prod 会开启日志滚动、监控端点、安全响应头
SPRING_PROFILES_ACTIVE=prod

# JWT 签名密钥：至少 32 位随机字符串（生产必改）
JWT_SECRET=change-me-please-32-chars-minimum
# 访问令牌 24h、刷新令牌 30 天（毫秒）
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-REPLACE-ME
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Web Push VAPID 密钥对（base64url 编码的 P-256 密钥；本地 .env 里已有一对可复用）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 跨域来源（逗号分隔）；同源部署（Nginx 反代）一般留空即可
CORS_ALLOWED_ORIGINS=
